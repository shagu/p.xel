export gif idle-sw.gif tag=idle_sw scale=3
export gif idle-w.gif tag=idle_w scale=3
export gif idle-nw.gif tag=idle_nw scale=3
export gif idle-n.gif tag=idle_n scale=3
export gif idle-ne.gif tag=idle_ne scale=3
