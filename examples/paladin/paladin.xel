end
tag idle_nw 79 83

# ---------- idle n ----------
frame idle_n_0 dur=220
  draw pal n 0 3 0 -3 0 0 0
end
frame idle_n_1 dur=180
  draw pal n 0 3 0 -3 0 0 1
end
frame idle_n_2 dur=240
  draw pal n -1 3 0 -3 0 1 1
end
frame idle_n_3 dur=200
