export sheet walk-sheet.png rows=walk_s,walk_sw,walk_w,walk_nw,walk_n,walk_ne,walk_e,walk_se scale=2
export sheet idle-sheet.png rows=idle_s,idle_sw,idle_w,idle_nw,idle_n,idle_ne,idle_e,idle_se scale=2
export gif walk-s.gif tag=walk_s scale=3
export gif walk-sw.gif tag=walk_sw scale=3
export gif walk-w.gif tag=walk_w scale=3
export gif walk-nw.gif tag=walk_nw scale=3
export gif walk-n.gif tag=walk_n scale=3
export gif walk-ne.gif tag=walk_ne scale=3
export gif walk-e.gif tag=walk_e scale=3
