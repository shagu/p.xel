end
tag idle_w 74 78

# ---------- idle nw ----------
frame idle_nw_0 dur=220
  draw palm ne 0 3 0 -3 0 0 0
end
frame idle_nw_1 dur=180
  draw palm ne 0 3 0 -3 0 0 1
end
frame idle_nw_2 dur=240
  draw palm ne -1 3 0 -3 0 1 1
end
frame idle_nw_3 dur=200
  draw palm ne -1 3 0 -3 0 1 0
end
frame idle_nw_4 dur=260
