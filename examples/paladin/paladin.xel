# ---------- idle ne ----------
frame idle_ne_0 dur=220
  draw pal ne 0 3 0 -3 0 0 0
end
frame idle_ne_1 dur=180
  draw pal ne 0 3 0 -3 0 0 1
end
frame idle_ne_2 dur=240
