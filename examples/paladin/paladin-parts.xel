# ---------- assembly ----------
# one leg with its foot: hip (hx,hy), resting ankle (ax,ay), stride st along the
# walking direction (ux,uy) in screen px, lift li, foot variant d
part stride hx hy ax ay st li ux uy far d
  let fx = round($ax+$st*$ux)
  let fy = round($ay+$st*$uy-$li)
  draw leg $hx $hy $fx $fy (round($li*$ux*0.8)) (round($li*$uy*0.8)) $far
  draw foot_$d $fx ($fy+2) $far
end

# pose parameters (same table for every direction, see paladin.xel):
# b body bob, rs/rl right leg stride/lift, ls/ll left leg stride/lift,
# aw weapon arm swing, sw cape and hem sway (lags one frame)
part pal_s b rs rl ls ll aw sw
  let hy = round($aw*0.5)
  draw cape 24 40 (22+$b) 21 43 50 $sw 1 n=0
  draw stride 27 (36+$b) 27 53 $rs $rl 0 0.5 0 s
  draw stride 37 (36+$b) 37 53 $ls $ll 0 0.5 1 s
  draw body_s $b
  draw tabbot_s $b $sw
  draw arm 21 (22+$b) 21 (29+$b+round($hy/2)) 21 (34+$b+$hy) 0 er=1
  draw mace 21 (36+$b+$hy) 21 (44+$b+$hy)
  draw fist 21 (34+$b+$hy) 0
  draw shield_s 39 (19+$b-round($aw*0.25))
end

part pal_se b rs rl ls ll aw sw
  let hx = round($aw*0.9)
  let hy = round($aw*0.45)
  draw cape 22 36 (21+$b) 16 34 50 $sw 1
  draw stride 37 (34+$b) 37 51 $ls $ll 0.9 0.45 1 se
  draw stride 28 (36+$b) 28 54 $rs $rl 0.9 0.45 0 se
  draw body_se $b
  draw tabbot_se $b $sw
  draw arm 22 (22+$b) (22+round($hx/2)) (29+$b+round($hy/2)) (22+$hx) (34+$b+$hy) 0 er=1
  draw mace (22+$hx) (36+$b+$hy) (24+$hx) (44+$b+$hy)
  draw fist (22+$hx) (34+$b+$hy) 0
  draw shield_se (39-round($aw*0.4)) (19+$b-round($aw*0.2))
end

part pal_e b rs rl ls ll aw sw
  draw cape 24 30 (18+$b) 18 29 50 ($sw*2) 1 n=2
  draw stride 32 (35+$b) 32 53 $ls $ll 1 0 1 e
  draw stride 31 (36+$b) 31 54 $rs $rl 1 0 0 e
  draw body_e $b
  draw tabbot_e $b $sw
  draw shield_e (37-round($aw*0.3)) (20+$b)
  draw arm 29 (23+$b) (29+round($aw/2)) (29+$b) (30+$aw) (34+$b) 0 el=1 er=1
  draw mace (30+$aw) (36+$b) (36+$aw) (42+$b)
  draw fist (30+$aw) (34+$b) 0
end

part pal_ne b rs rl ls ll aw sw
  let hx = round($aw*0.6)
  let hy = round(-$aw*0.3)
  draw shield_ne (18-round($aw*0.3)) (20+$b+round($aw*0.2))
  draw stride 28 (34+$b) 28 51 $ls $ll 0.9 -0.45 1 ne
  draw stride 37 (36+$b) 37 54 $rs $rl 0.9 -0.45 0 ne
  draw body_ne $b
  draw arm 23 (21+$b) 22 (27+$b) 21 (31+$b) 1 er=1
  draw fist 21 (31+$b) 1
  draw cape 23 35 (20+$b) 17 37 46 $sw 1
  draw arm 41 (22+$b) (41+round($hx/2)) (29+$b+round($hy/2)) (41+$hx) (34+$b+$hy) 0 el=1
  draw mace (41+$hx) (36+$b+$hy) (44+$hx) (43+$b+$hy)
  draw fist (41+$hx) (34+$b+$hy) 0
end

part pal_n b rs rl ls ll aw sw
  let hy = round(-$aw*0.5)
  draw shield_n 13 (19+$b+round($aw*0.25))
  draw stride 27 (36+$b) 27 53 $ls $ll 0 -0.5 0 n
  draw stride 37 (36+$b) 37 53 $rs $rl 0 -0.5 1 n
  draw body_n $b
  draw arm 21 (22+$b) 20 (28+$b) 19 (32+$b) 0 er=1
  draw fist 19 (32+$b) 0
  draw arm 43 (22+$b) 43 (29+$b+round($hy/2)) 43 (34+$b+$hy) 1 el=1
  draw mace 43 (35+$b+$hy) 44 (42+$b+$hy)
  draw fist 43 (34+$b+$hy) 1
  draw cape 27 37 (20+$b) 21 43 46 $sw 1
end

# selout outline, then the flat 2:1 floor shadow under the feet (behind the figure)
part finish
  outline void
  only empty
    oval 32 56 12 4 void
  end
end

# relight a mirrored figure: its baked rim light now sits on the right edge, sink
# that edge one step (finish then lifts the left edge with the shared tl rim)
part relight
  rim dir=r steps=-1
end

# figure without outline: one drawn direction plus one row of the pose table
part fig d b rs rl ls ll aw sw
  draw pal_$d $b $rs $rl $ls $ll $aw $sw
end

# mirrored figure: sw = se, w = e, nw = ne flipped around x = 63 - x, then relit
part figm d b rs rl ls ll aw sw
  group flipx=63
    draw pal_$d $b $rs $rl $ls $ll $aw $sw
  end
  draw relight
end

# whole sprite frames (transparent background)
part pal d b rs rl ls ll aw sw
  draw fig $d $b $rs $rl $ls $ll $aw $sw
  draw finish
end
part palm d b rs rl ls ll aw sw
  draw figm $d $b $rs $rl $ls $ll $aw $sw
  draw finish
end
