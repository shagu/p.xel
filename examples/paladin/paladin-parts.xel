# ---------- cape ----------
# gathered at the shoulders (tlx..trx at ty), flaring to the hem (blx..brx at by).
# the hem trails by sw (lags the body one frame), n folds fan out from the clasp:
# each fold is a lit ridge and a shadow valley that taper from 1 px to 2 px, the hem
# is scalloped (ridges hang lower, valleys tuck up) and ripples with sw
part cape tlx trx ty blx brx by sw c n=4
  let bl = $blx+$sw
  let br = $brx+$sw
  let my = round($ty+($by-$ty)*0.6)
  let mlx = round($tlx+($bl-$tlx)*0.6)-1
  let mrx = round($trx+($br-$trx)*0.6)+1
  shape $tlx,$ty $trx,$ty $mrx,$my $br,$by $bl,$by $mlx,$my blood.$c
  line $tlx $ty $mlx $my blood.($c+1)
  line $mlx $my $bl $by blood.($c+1)
  repeat $n as k
    let xt = round($tlx+($trx-$tlx)*($k+0.5)/$n)
    let xb = round($bl+($br-$bl)*($k+0.5)/$n)+(($k*5+1)%3)-1
    let hb = $by+(($k+$sw+10)%2)
    shape $xt,($ty+2) ($xb-1),$hb $xb,$hb blood.($c+1)
    shape ($xt+1),($ty+3) ($xb+1),($by-1) ($xb+2),($by-1) blood.($c-1)
    px ($xb+2) $by none
  end
  # the first fold catches the light near the shoulders
  let xt0 = round($tlx+($trx-$tlx)*0.5/max($n,1))
  let xb0 = round($bl+($br-$bl)*0.5/max($n,1))-1
  let hc = min($c+2,4)
  line $xt0 ($ty+2) (round(($xt0+$xb0)/2)) $my blood.$hc
  line $trx $ty $mrx $my blood.($c-1)
  line $mrx $my $br $by blood.($c-1)
end

