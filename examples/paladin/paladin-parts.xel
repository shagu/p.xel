# ---------- generic limbs ----------
let el = 0
let er = 0
# plate arm: shoulder (sx,sy) -> elbow (ex,ey) -> wrist (hx,hy), 4 px thick
part arm sx sy ex ey hx hy far
  # dark crease where the arm passes in front of the body (el left, er right)
  repeat $el
    line ($sx-3) ($sy+2) ($ex-3) $ey steel.0
    line ($ex-3) $ey ($hx-3) ($hy-1) steel.0
  end
  repeat $er
    line ($sx+2) ($sy+2) ($ex+2) $ey steel.0
    line ($ex+2) $ey ($hx+2) ($hy-1) steel.0
  end
  repeat 4 as i
    let c = if($i<2,3,if($i<3,2,1))-$far
    line ($sx-2+$i) $sy ($ex-2+$i) $ey steel.$c
    line ($ex-2+$i) $ey ($hx-2+$i) $hy steel.$c
  end
  # elbow cop and gold cuff
  hline ($ex-2) $ey 4 steel.(4-$far)
  hline ($ex-2) ($ey+1) 4 steel.(1-$far)
  hline ($hx-2) ($hy-1) 4 gold.(3-$far)
end

# gauntlet fist around the grip at (hx,hy)
part fist hx hy far
  art ($hx-2) $hy
    lwwm
    llmd
    mmdd
  end
end

# flanged mace: grip at (hx,hy), head centre at (tx,ty)
part mace hx hy tx ty
  line $hx $hy $tx $ty gold.1
  # void ring keeps the head readable against the dark cape
  art ($tx-3) ($ty-4)
    ..oyo..
    .olwmo.
    olw*lmo
    olwllmo
    olllmdo
    .ommdo.
    ..ooo..
    .......
  end
end

