# paladin-parts: heavy armored paladin for an isometric dark fantasy rpg
# style   : dark-fantasy-iso (diablo ii flavoured), light tl, selout outline
# canvas  : parts are drawn for a 64x64 cell, feet anchor at x=32 y=56
# sizes   : helm top y8, helm 9 wide, shoulders 29 wide, belt y30, hem y44,
#           ankles y53, soles y55-56 (near foot 1 px lower in the diagonal views)
# palette : dark-fantasy steel (armor), gold (trim, cross), blood (tabard, cape,
#           shield field), void (shadow)
# dirs    : drawn s se e ne n, mirrored sw w nw with group flipx=63
# parts   : body_<d> tabtop_<d> tabbot_<d> shield_<d> foot_<d> per direction,
#           generic leg arm fist mace cape knee0/1, assembled by pal_<d> in the
#           z-order of that direction; fig / figm (mirrored + relight) / pal / palm
#           wrap them, finish adds the selout outline and the floor shadow
palette dark-fantasy
# diablo ii mood: grimy desaturated steel, tarnished gold, dried blood red
ramp steel #0c0c0f #1d1e22 #34363b #55575a #8a8a84
ramp gold #170f05 #36250e #5e451c #8c6c32 #bb9a55
ramp blood #100304 #2a080a #4c1012 #74191a #9c2c24
color glint #d6d2bf
map
  * glint
  o void
  k steel.0
  d steel.1
  m steel.2
  l steel.3
  w steel.4
  u gold.0
  y gold.1
  g gold.2
  G gold.3
  Y gold.4
  q blood.0
  r blood.1
  R blood.2
  e blood.3
  E blood.4
end

part leg hx hy ax ay bx by far
  let kx = round(($hx+$ax)/2+$bx)
  let ky = round(($hy+$ay)/2+$by)
  # dark crease where the leg overlaps something already drawn (never on the outline)
  only solid
    line ($hx-4) $hy ($kx-4) $ky steel.0
    line ($hx+3) $hy ($kx+3) $ky steel.0
    line ($kx-3) $ky ($ax-3) $ay steel.0
    line ($kx+3) $ky ($ax+3) $ay steel.0
  end
  repeat 6 as i
    let c = if($i<2,3,if($i<4,2,1))-$far
    line ($hx-3+$i) $hy ($kx-3+$i) $ky steel.$c
  end
  repeat 5 as i
    let c = if($i<2,3,if($i<4,2,1))-$far
    line ($kx-2+$i) $ky ($ax-2+$i) $ay steel.$c
  end
  # greave ridge catches the light
  line ($kx-1) ($ky+2) ($ax-1) ($ay-1) steel.(4-$far)
  draw knee$far $kx $ky
end

part knee0 x y
  art ($x-2) ($y-1)
    .lww.
    llwwd
    mmmdd
  end
end
part knee1 x y
  art ($x-2) ($y-1)
    .mll.
    mmllk
    dddkk
  end
end

part foot_s x y far
  art ($x-3) ($y-3)
